# The Data Binding Service against the mock ICIS (mock-icis/, :3200) --
# demo data only, no real credentials. Used by `npm run demo`.
ADAPTER=icis
PORT=3100
DYNAMICS_URL=http://localhost:3200
ICIS_STATIC_TOKEN=mock-icis-demo-token
# Re-check this service's own privileges on every request, so granting or
# revoking one in the mock's "Service account" page shows immediately.
ICIS_PRIVILEGE_CACHE_MS=0
BINDINGS_FILE=data/bindings.demo.json
# The DBS's own database (not form-builder's), on the local Postgres from
# docker compose. Created and migrated by `npm run db:migrate:demo`.
DATABASE_URL=postgresql://formbuilder:formbuilder@localhost:5432/binding_service_demo
