# "fake" serves an in-memory client store (no ICIS needed); "icis" talks to
# Dataverse with the app registration below.
ADAPTER=fake
PORT=3100
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
DYNAMICS_URL=https://orgname.crm6.dynamics.com

# Where bindings made in the binding creator are kept (default:
# binding-service/data/bindings.<adapter>.json).
# BINDINGS_FILE=

# DBS-owned identities (client anchor IDs, option codes). Default:
# binding-service/data/identity.<adapter>.json
# IDENTITY_FILE=
