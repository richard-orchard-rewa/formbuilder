# "fake" serves an in-memory client store (no ICIS needed); "icis" talks to
# Dataverse with the app registration below.
ADAPTER=fake
PORT=3100
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
DYNAMICS_URL=https://orgname.crm6.dynamics.com


# The DBS's own database (not form-builder's), holding the identities it
# issues (client anchor IDs, option codes) and the bindings stewards create.
# Required unless ADAPTER=fake.
# Create and migrate it with `npm run db:migrate -w binding-service`.
DATABASE_URL=postgresql://formbuilder:formbuilder@localhost:5432/binding_service
