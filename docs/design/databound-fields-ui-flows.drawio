<mxfile host="formbuilder" type="device"><diagram id="overview" name="0 · Overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="overview-1" value="Data-bound fields — UI flows" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#002742;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="26" as="geometry"/></mxCell><mxCell id="overview-2" value="Low-fidelity flows for the data-bound field user stories, laid out after the form-builder prototype (navy sidebar, pill buttons, three-column builders). They show what people see and do, not how it&#x27;s built." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5e6d76;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1100" height="34" as="geometry"/></mxCell><mxCell id="overview-3" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Solid frame — a screen or state the prototype already has&lt;br&gt;&lt;font color=&#x27;#7b5700&#x27;&gt;Dashed amber frame, PROPOSED&lt;/font&gt; — needed by a story, not built yet&lt;br&gt;Arrow — something the person does, labelled with the action&lt;br&gt;Diamond — a check the system makes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d7e0e5;fontSize=11;fontColor=#002742;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="360" height="150" as="geometry"/></mxCell><mxCell id="overview-4" value="Page" style="rounded=0;fillColor=#f5f7f8;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="60" height="26" as="geometry"/></mxCell><mxCell id="overview-5" value="Flow" style="rounded=0;fillColor=#f5f7f8;strokeColor=#e6ecef;fontSize=11;fontColor=#002