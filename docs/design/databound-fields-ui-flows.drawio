><mxCell id="p6-5" value="US-D.17" style="rounded=1;arcSize=50;fillColor=#d9f0ee;strokeColor=none;fontColor=#1d4f45;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="246" y="54" width="61" height="20" as="geometry"/></mxCell><mxCell id="p6-6" value="Drafts never change the source system. Submitting saves the note and sends only real changes, each with its own result; someone else&#x27;s newer change is never overwritten." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5e6d76;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1100" height="34" as="geometry"/></mxCell><mxCell id="p6-7" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d7e0e5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="300" height="144" as="geometry"/></mxCell><mxCell id="p6-8" value="1. Note with changes" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#002742;align=left;verticalAlign=middle;" vertex="1" parent="p6-7"><mxGeometry x="0" y="-22" width="300" height="18" as="geometry"/></mxCell><mxCell id="p6-9" value="" style="rounded=0;fillColor=#004576;strokeColor=none;" vertex="1" parent="p6-7"><mxGeometry x="0" y="0" width="14" height="144" as="geometry"/></mxCell><mxCell id="p6-10" value="Practitioner portal" style="text;html=1;fontSize=8;fontColor=#5e6d76;align=left;verticalAlign=middle;" vertex="1" parent="p6-7"><mxGeometry x="22" y="6" width="268" height="14" as="geometry"/></mxCell><mxCell id="p6-11" value="Session 3" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#002742;align=left;verticalAlign=middle;" vertex="1" parent="p6-7"><mxGeometry x="22" y="28" width="268" height="18" as="geometry"/></mxCell><mxCell id="p6-12" value="Draft note" style="rounded=1;arcSize=50;fillColor=#fff0c7;strokeColor=none;fontColor=#7b5700;fontSize=8;fontStyle=1;" vertex="1" parent="p6-7"><mxGeometry x="22" y="53" width="62" height="16" as="geometry"/