ell><mxCell id="p6-21" value="If the connection drops: &#x27;Connection problem — trying again… The note isn&#x27;t saved yet.&#x27;" style="text;html=1;whiteSpace=wrap;fontSize=9;fontColor=#5e6d76;align=left;verticalAlign=top;" vertex="1" parent="p6-16"><mxGeometry x="22" y="54" width="268" height="28" as="geometry"/></mxCell><mxCell id="p6-22" value="Note stored?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e6d76;fontSize=10;fontColor=#002742;" vertex="1" parent="1"><mxGeometry x="965" y="175" width="130" height="70" as="geometry"/></mxCell><mxCell id="p6-23" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d7e0e5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1300" y="170" width="300" height="94" as="geometry"/></mxCell><mxCell id="p6-24" value="3a. Saved, still sending to ICIS" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#002742;align=left;verticalAlign=middle;" vertex="1" parent="p6-23"><mxGeometry x="0" y="-22" width="300" height="18" as="geometry"/></mxCell><mxCell id="p6-25" value="" style="rounded=0;fillColor=#004576;strokeColor=none;" vertex="1" parent="p6-23"><mxGeometry x="0" y="0" width="14" height="94" as="geometry"/></mxCell><mxCell id="p6-26" value="Practitioner portal" style="text;html=1;fontSize=8;fontColor=#5e6d76;align=left;verticalAlign=middle;" vertex="1" parent="p6-23"><mxGeometry x="22" y="6" width="268" height="14" as="geometry"/></mxCell><mxCell id="p6-27" value="Session note saved. Sending its changes to ICIS… It keeps trying; you can leave this page." style="rounded=1;arcSize=8;fillColor=#e9f5ff;strokeColor=none;fontColor=#004576;fontSize=9;whiteSpace=wrap;html=1;align=left;spacingLeft=5;" vertex="1" parent="p6-23"><mxGeometry x="22" y="28" width="268" height="32" as="geometry"/></mxCell><mxCell id="p6-28" value="Skipped when ICIS answers straight away." style="text;html=1;whiteSpace=wrap;fontSize=9;fontColor=#5e6d76;align=left;