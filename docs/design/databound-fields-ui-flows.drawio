and fill in a note" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="100" y="430" width="400" height="26" as="geometry"/></mxCell><mxCell id="overview-21" value="US-D.7, D.8, D.9, D.11, D.12, D.13" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="430" width="260" height="26" as="geometry"/></mxCell><mxCell id="overview-22" value="6" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="60" height="26" as="geometry"/></mxCell><mxCell id="overview-23" value="Practitioner: save a draft or submit" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="100" y="456" width="400" height="26" as="geometry"/></mxCell><mxCell id="overview-24" value="US-D.14, D.15, D.16, D.17" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="456" width="260" height="26" as="geometry"/></mxCell><mxCell id="overview-25" value="7" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="482" width="60" height="26" as="geometry"/></mxCell><mxCell id="overview-26" value="Reading a submitted note later" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="100" y="482" width="400" height="26" as="geometry"/></mxCell><mxCell id="overview-27" value="US-D.10" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="482" width="260" height="26" as="geometry"/></mxCell><mxCell id="overview-28" value="8" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="508" width="60" height="26" as="geometry"/></mxCell><mxCell id="overview-29" value="Privacy officer: trace changes to a client&#x27;s record" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="100" y="508" width="400" height="26" as="geometry"/></mxCell><mxCell id="overview-30" value="US-D.21" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=11;fontColor=#002742;align=left;spacingLeft=6;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="500" y="508" width="260" height="26" as="geometry"/></mxCell><mxCell id="overview-31" value="No screen of their own: US-D.3 (forms survive a new source system), US-D.18 (one controlled route) and US-D.19 (no source-system IDs in forms) are rules behind every flow. US-D.20 appears only as refusal messages on page 1." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fff9db;strokeColor=#e0c96b;fontSize=10;fontColor=#5b4a00;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="554" width="720" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="1 · Steward: publish"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-1" value="1 · Data steward: publish a data-bound field" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#002742;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="26" as="geometry"/></mxCell><mxCell id="p1-2" value="US-D.1" style="rounded=1;arcSize=50;fillColor=#d9f0ee;strokeColor=none;fontColor=#1d4f45;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="54" height="20" as="geometry"/></mxCell><mxCell id="p1-3" value="US-D.20" style="rounded=1;arcSize=50;fillColor=#d9f0ee;strokeColor=none;fontColor=#1d4f45;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="102" y="54" width="61" height="20" as="geometry"/></mxCell><mxCell id="p1-4" value="The steward turns an approved source-system column into a named field builders can use. What the source system allows is read, never typed in, and can only be tightened." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5e6d76;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1100" height="34" as="geometry"/></mxCell><mxCell id="p1-5" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d7e0e5;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="300" height="298" as="geometry"/></mxCell><mxCell id="p1-6" value="1. Data bindings" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#002742;align=left;verticalAlign=middle;" vertex="1" parent="p1-5"><mxGeometry x="0" y="-22" width="300" height="18" as="geometry"/></mxCell><mxCell id="p1-7" value="" style="rounded=0;fillColor=#004576;strokeColor=none;" vertex="1" parent="p1-5"><mxGeometry x="0" y="0" width="14" height="298" as="geometry"/></mxCell><mxCell id="p1-8" value="Form Administration System" style="text;html=1;fontSize=8;fontColor=#5e6d76;align=left;verticalAlign=middle;" vertex="1" parent="p1-5"><mxGeometry x="22" y="6" width="268" height="14" as="geometry"/></mxCell><mxCell id="p1-9" value="Data bindings" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#002742;align=left;verticalAlign=middle;" vertex="1" parent="p1-5"><mxGeometry x="22" y="28" width="268" height="18" as="geometry"/></mxCell><mxCell id="p1-10" value="Fields that read from, and save back to, the source system. Published ones appear in the builder&#x27;s Data bound palette." style="text;html=1;whiteSpace=wrap;fontSize=9;fontColor=#5e6d76;align=left;verticalAlign=top;" vertex="1" parent="p1-5"><mxGeometry x="22" y="52" width="268" height="40" as="geometry"/></mxCell><mxCell id="p1-11" value="Binding" style="rounded=0;fillColor=#f5f7f8;strokeColor=#e6ecef;fontSize=8;fontStyle=1;fontColor=#5e6d76;align=left;spacingLeft=3;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="p1-5"><mxGeometry x="22" y="98" width="89" height="16" as="geometry"/></mxCell><mxCell id="p1-12" value="On forms" style="rounded=0;fillColor=#f5f7f8;strokeColor=#e6ecef;fontSize=8;fontStyle=1;fontColor=#5e6d76;align=left;spacingLeft=3;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="p1-5"><mxGeometry x="111" y="98" width="89" height="16" as="geometry"/></mxCell><mxCell id="p1-13" value="Version" style="rounded=0;fillColor=#f5f7f8;strokeColor=#e6ecef;fontSize=8;fontStyle=1;fontColor=#5e6d76;align=left;spacingLeft=3;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="p1-5"><mxGeometry x="201" y="98" width="89" height="16" as="geometry"/></mxCell><mxCell id="p1-14" value="Mobile phone" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=8;fontStyle=0;fontColor=#002742;align=left;spacingLeft=3;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="p1-5"><mxGeometry x="22" y="120" width="89" height="16" as="geometry"/></mxCell><mxCell id="p1-15" value="Editable, up to 50" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=8;fontStyle=0;fontColor=#002742;align=left;spacingLeft=3;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="p1-5"><mxGeometry x="111" y="120" width="89" height="16" as="geometry"/></mxCell><mxCell id="p1-16" value="v1 · published" style="rounded=0;fillColor=#ffffff;strokeColor=#e6ecef;fontSize=8;fontStyle=0;font