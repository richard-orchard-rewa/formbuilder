{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "client"
      ],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "server"
      ],
      "port": 3000
    },
    {
      "name": "binding-service",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "binding-service"
      ],
      "port": 3100
    },
    {
      "name": "mock-icis",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "mock-icis"
      ],
      "port": 3200
    },
    {
      "name": "binding-service-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "demo",
        "-w",
        "binding-service"
      ],
      "port": 3100
    },
    {
      "name": "practitioner-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "practitioner-portal"
      ],
      "port": 5180
    },
    {
      "name": "practitioner-portal-alt-port",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "practitioner-portal",
        "--",
        "--port",
        "5181"
      ],
      "port": 5181
    },
    {
      "name": "practitioner-portal-no-dbs",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set BINDING_SERVICE_URL=http://localhost:3999&& npm run dev -w practitioner-portal -- --port 5182"
      ],
      "port": 5182
    }
  ]
}
